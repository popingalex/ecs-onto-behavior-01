  },
  {
    "id": "D09",
    "title": "变量绑定",
    "page": "P15",
    "fields": [
      {
        "key": "root",
        "label": "来源",
        "control": "select",
        "default": "self",
        "validation": "当前作用域可见",
        "options": [
          "self",
          "parameter",
          "upstream",
