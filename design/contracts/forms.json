[
  {
    "id": "D01",
    "title": "新建类型",
    "page": "P02",
    "fields": [
      {
        "key": "id",
        "label": "稳定key",
        "control": "text",
        "default": "",
        "validation": "必填；ASCII key；项目唯一"
      },
      {
        "key": "name",
        "label": "显示名",
        "control": "text",
        "default": "",
        "validation": "必填，≤80字"
      },
      {
        "key": "parent",
        "label": "父类型",
        "control": "typeRef",
        "default": null,
        "validation": "不可循环"
      }
    ],
    "command": "CreateType",
    "result": "创建草稿后选中新类型"
  },
  {
    "id": "D02",
    "title": "新增属性",
    "page": "P03",
    "fields": [
      {
        "key": "id",
        "label": "属性ID",
        "control": "text",
        "default": "",
        "validation": "组件内唯一，发布后不重用"
      },
      {
        "key": "shape",
        "label": "值形状",
        "control": "select",
        "default": "scalar",
        "validation": "必选",
        "options": [
          "scalar",
          "vector3",
          "matrixRef"
        ]
      },
      {
        "key": "primitive",
        "label": "基础类型",
        "control": "select",
        "default": "f64",
        "validation": "shape和类型兼容",
        "options": [
          "f64",
          "i64",
          "bool",
          "string",
          "EntityRef"
        ]
      },
      {
        "key": "unitId",
        "label": "单位",
        "control": "unitRef",
        "default": "degC",
        "validation": "量种兼容"
      },
      {
        "key": "nullable",
        "label": "允许无值",
        "control": "switch",
        "default": false,
        "validation": "bool"
      },
      {
        "key": "default",
        "label": "默认值",
        "control": "typedValue",
        "default": 100,
        "validation": "不可空字段必须有效"
      },
      {
        "key": "writeMode",
        "label": "写入方式",
        "control": "select",
        "default": "contribution",
        "validation": "必须与属性归约契约一致",
        "options": [
          "configuration",
          "exclusive",
          "contribution",
          "contract"
        ]
      }
    ],
    "command": "AddProperty",
    "result": "新增未发布模式，不能回写运行"
  },
  {
    "id": "D03",
    "title": "关系定义",
    "page": "P02",
    "fields": [
      {
        "key": "id",
        "label": "关系key",
        "control": "text",
        "default": "",
        "validation": "唯一"
      },
      {
        "key": "source",
        "label": "源类型",
        "control": "typeRef",
        "default": "FoamTruck",
        "validation": "必有"
      },
      {
        "key": "target",
        "label": "目标类型",
        "control": "typeRef",
        "default": "Fire",
        "validation": "必有"
      },
      {
        "key": "cardinality",
        "label": "基数",
        "control": "select",
        "default": "0..1",
        "validation": "支持约定集合",
        "options": [
          "0..1",
          "1",
          "0..*",
          "1..*"
        ]
      },
      {
        "key": "onDelete",
        "label": "目标删除",
        "control": "select",
        "default": "restrict",
        "validation": "运行结构操作要显式裁决",
        "options": [
          "restrict",
          "clearRef",
          "cascadeDefined"
        ]
      }
    ],
    "command": "AddRelation",
    "result": "预览现有实例是否违反基数"
  },
  {
    "id": "D04",
    "title": "位置与空值",
    "page": "P07",
    "fields": [
      {
        "key": "frameId",
        "label": "坐标系",
        "control": "select",
        "default": "park-ENU",
        "validation": "必须与scene一致"
      },
      {
        "key": "position",
        "label": "东/北/高",
        "control": "vector3",
        "default": [
          320,
          180,
          0
        ],
        "validation": "三个有限数；m"
      },
      {
        "key": "clear",
        "label": "未设置",
        "control": "explicitNull",
        "default": false,
        "validation": "仅nullable允许；不删除实体"
      }
    ],
    "command": "SetScenePosition",
    "result": "空间投影与实体表同步；单一撤销步骤"
  },
  {
    "id": "D05",
    "title": "模板实例化",
    "page": "P05",
    "fields": [
      {
        "key": "template",
        "label": "模板版本",
        "control": "templateRef",
        "default": "tpl-foam@t3",
        "validation": "固定版本"
      },
      {
        "key": "name",
        "label": "实体名",
        "control": "text",
        "default": "新泡沫车",
        "validation": "必填"
      },
      {
        "key": "placement",
        "label": "位置",
        "control": "vector3",
        "default": null,
        "validation": "null合法，原点合法"
      },
      {
        "key": "overrides",
        "label": "属性覆盖",
        "control": "propertyGrid",
        "default": {},
        "validation": "基于definition校验"
      }
    ],
    "command": "InstantiateTemplate",
    "result": "新稳定entityId；保留覆盖来源"
  },
  {
    "id": "D06",
    "title": "查询条件",
    "page": "P10",
    "fields": [
      {
        "key": "classId",
        "label": "类型",
        "control": "typeRef",
        "default": "Fire",
        "validation": "必有"
      },
      {
        "key": "groups",
        "label": "条件",
        "control": "conditionBuilder",
        "default": [
          {
            "property": "active",
            "op": "eq",
            "value": true
          }
        ],
        "validation": "AND/OR有类型；缺位置显式处理"
      },
      {
        "key": "view",
        "label": "读取视图",
        "control": "select",
        "default": "previous",
        "validation": "默认previous"
      },
      {
        "key": "sort",
        "label": "排序",
        "control": "select",
        "default": "id",
        "validation": "稳定排序"
      }
    ],
    "command": "SaveQuery",
    "result": "预览三实体；保存版本才更新引用"
  },
  {
    "id": "D07",
    "title": "System绑定",
    "page": "P11",
    "fields": [
      {
        "key": "id",
        "label": "System ID",
        "control": "text",
        "default": "cool-A",
        "validation": "唯一"
      },
      {
        "key": "graphRef",
        "label": "逻辑版本",
        "control": "graphRef",
        "default": "g-cool@g4",
        "validation": "已存在"
      },
      {
        "key": "queryId",
        "label": "实体查询",
        "control": "queryRef",
        "default": "q-fire",
        "validation": "类型兼容"
      },
      {
        "key": "maxDropK",
        "label": "最大降温",
        "control": "quantity",
        "default": 50,
        "validation": "≥0；deltaK"
      },
      {
        "key": "sourceC",
        "label": "冷源温度",
        "control": "quantity",
        "default": 20,
        "validation": "degC绝对温度"
      },
      {
        "key": "enabled",
        "label": "启用",
        "control": "switch",
        "default": true,
        "validation": "bool"
      }
    ],
    "command": "UpdateSystem",
    "result": "显示计划变化，发布后或分支覆盖才影响运行"
  },
  {
    "id": "D08",
    "title": "图连线",
    "page": "P14",
    "fields": [
      {
        "key": "sourceNode",
