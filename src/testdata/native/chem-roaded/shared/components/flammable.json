  "tags": [],
  "config": {
    "effects": [
      {
        "id": "flame_particles",
        "type": "particle",
        "trigger": {
          "state": "flammable/fire"
        },
        "params": {
          "particleType": "fire",
          "radius": "$tank/radius",
          "height": "$tank/height",
          "intensity": 1
        }
      }
    ],
    "state": [
      {
        "id": "flammable/fire",
        "name": "火灾",
        "type": "affected",
        "show": {
          "expression": "'flammable/is_burning' == 1"
        },
        "hide": {
          "enabled": true
        },
        "metric": {
          "expression": "'flammable/equivalent_fire_area' / 'tank/tank_top_total_area' * 100",
          "label": "火面积",
          "format": "percentage",
          "precision": 1,
          "yAxis": "right",
          "trend": {
            "enabled": true
          }
        }
      },
      {
        "id": "flammable/fire_temperature",
        "name": "温度",
        "type": "affected",
        "show": {
          "expression": "'flammable/is_burning' == 1"
        },
        "hide": {
          "enabled": true
        },
        "metric": {
          "expression": "flammable/temperature",
          "label": "温度",
          "format": "temperature",
          "precision": 1,
          "yAxis": "left",
          "trend": {
            "enabled": true
          }
        }
      }
    ],
    "event": [
      {
        "expression": "'flammable/is_burning' == 1",
        "name": "点燃",
        "category": "danger"
      },
      {
        "expression": "'flammable/is_burning' == 0",
        "name": "熄灭",
        "category": "success"
      }
    ],
    "command": [
      {
        "id": "action_ignite",
        "name": "点燃",
        "kind": "ignite"
      }
    ]
  }
}
