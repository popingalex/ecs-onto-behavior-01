      "value": "人员",
      "type": "s",
      "config": {
        "layer": "display"
      }
    },
    {
      "id": "personnel/personnel_kind",
      "name": "人员类型",
      "value": "rescue",
      "type": "s",
      "config": {
        "layer": "attribute"
      }
    },
    {
      "id": "personnel/load_units",
      "name": "载荷单位",
      "value": 1,
      "type": "n",
      "config": {
        "layer": "attribute"
      }
    },
    {
      "id": "personnel/transport_state",
      "name": "运输状态",
      "value": {
        "kind": "on_map"
      },
      "type": "u",
      "config": {
        "layer": "display",
        "description": "on_map | on_board | boarding | disembarking"
      }
    },
    {
      "id": "personnel/transport_state_kind",
      "name": "运输状态类别",
      "value": "on_map",
      "type": "s",
      "config": {
        "layer": "display",
        "description": "lc-transport 写出的 transport_state.kind 影子列：on_map | on_board | boarding | disembarking"
      }
    },
    {
      "id": "personnel/walk_speed",
      "name": "步行速度",
      "value": 2.0,
      "type": "n",
      "config": {
        "layer": "attribute",
        "unit": "m/s"
      }
    },
    {
      "id": "personnel/medical_status",
      "name": "医疗状态",
