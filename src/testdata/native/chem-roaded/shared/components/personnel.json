    },
    {
      "id": "source/external_id",
      "name": "外部数据唯一标识",
      "value": null,
      "type": "s",
      "config": {
        "layer": "display"
      }
    },
    {
      "id": "source/kind",
      "name": "外部数据种类",
      "value": null,
      "type": "s",
      "config": {
        "layer": "display"
      }
    },
    {
      "id": "source/link_state",
      "name": "外部数据关联状态",
      "value": null,
      "type": "s",
      "config": {
        "layer": "display"
      }
    },
    {
      "id": "vital/heart_rate",
      "name": "心率",
      "value": null,
      "type": "n",
      "config": {
        "layer": "display"
      }
    },
    {
      "id": "vital/spo2",
      "name": "血氧",
      "value": null,
      "type": "n",
      "config": {
        "layer": "display"
      }
    },
    {
      "id": "vital/temp",
      "name": "体温",
      "value": null,
      "type": "n",
      "config": {
        "layer": "display"
      }
    },
    {
      "id": "vital/device_id",
      "name": "体征设备ID",
      "value": null,
      "type": "s",
      "config": {
        "layer": "display"
      }
