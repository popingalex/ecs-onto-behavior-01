  ],
  "tags": [],
  "config": {
    "command": [
      {
        "id": "action_board",
        "name": "登车",
        "kind": "board",
        "target": [
          "instance"
        ],
        "params": {
          "carrierIdArg": "carrierId"
        }
      },
      {
        "id": "action_disembark",
        "name": "下车",
        "kind": "disembark"
      }
    ],
    "state": [
      {
        "id": "personnel/on_board",
        "name": "已乘载",
        "type": "transport",
        "show": {
          "expression": "personnel/transport_state_kind == 'on_board'"
        },
        "hide": {
          "enabled": true
        }
      },
      {
        "id": "personnel/boarding",
        "name": "登车",
        "type": "transport",
        "show": {
          "expression": "personnel/transport_state_kind == 'boarding'"
        },
        "hide": {
          "enabled": true
        }
      },
      {
        "id": "personnel/disembarking",
        "name": "下车",
        "type": "transport",
        "show": {
          "expression": "personnel/transport_state_kind == 'disembarking'"
        },
        "hide": {
          "enabled": true
        }
      },
      {
        "id": "personnel/contained",
        "name": "已收容",
        "type": "transport",
        "show": {
          "expression": "personnel/contained == 1"
        },
        "hide": {
          "enabled": true
        }
      }
    ]
  }
}
