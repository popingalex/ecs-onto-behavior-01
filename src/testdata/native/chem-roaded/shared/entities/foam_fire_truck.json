  "interactions": [
    {
      "id": "tank_volume_label",
      "kind": "label",
      "config": {
        "name": "水位标牌",
        "enterCondition": "water_tank/current_water_volume > 0",
        "displayItems": [
          {
            "id": "current_vol",
            "expression": "water_tank/current_water_volume",
            "format": "progress_with_max",
            "maxAttribute": "water_tank/total_water_volume",
            "precision": 1,
            "unit": "L"
          }
        ]
      }
    },
    {
      "id": "water_depleted_event",
      "kind": "event",
      "expression": "water_tank/current_water_volume <= 0",
      "config": {
        "event": "水量耗尽",
        "condition": {
          "operator": "lte",
          "value": 0
        },
        "category": "danger"
      }
    },
    {
      "id": "spraying_label",
      "kind": "label",
      "config": {
        "name": "喷射标牌",
        "enterCondition": "water_sprayer/is_spraying == 1",
        "displayItems": [
          {
            "id": "spray_text",
            "expression": "\"喷泡沫中\"",
            "format": "raw"
          }
        ]
      }
    }
  ],
  "config": {
    "effects": [
      {
        "id": "water_spray",
        "type": "spray",
        "params": {
          "effectType": "foam"
        }
      }
    ],
    "label": [
      {
        "name": "水量",
        "format": "table",
        "show": {
          "expression": "controlled/commands[?(@.command == 'action_spray_water' && @.status == 'executing')]"
        },
        "items": [
          {
            "label": "剩余水量",
            "expression": "'water_tank/current_water_volume' / 'water_tank/total_water_volume' * 100",
            "unit": "%"
          }
        ]
      }
    ],
    "command": [
      {
        "commandId": "action_spray_water",
        "kind": "spray",
        "params": {
          "range": {
            "attribute": "water_sprayer/range"
          },
          "target": [
            "instance"
          ]
        }
      },
      {
        "commandId": "action_spray_foam",
        "kind": "spray",
        "params": {
          "target": [
            "instance"
          ]
        }
      }
    ]
  },
