  "interactions": [
    {
      "id": "is_burning_event",
      "kind": "event",
      "expression": "flammable/is_burning == 1",
      "config": {
        "event": "燃烧状态变化",
        "transitions": [
          {
            "from": 0,
            "to": 1,
            "event": "点燃",
            "category": "danger"
          },
          {
            "from": 1,
            "to": 0,
            "event": "熄灭",
            "category": "normal"
          }
        ]
      }
    },
    {
      "id": "burning_label",
      "kind": "label",
      "config": {
        "name": "储罐标牌",
        "enterCondition": "flammable/is_burning == 1",
        "exitCondition": "flammable/is_burning == 0",
        "displayItems": [
          {
            "id": "temp_val",
            "expression": "container/temperature",
            "format": "temperature",
            "precision": 1
          },
          {
            "id": "dur_val",
            "expression": "health/durability",
            "format": "progress",
            "precision": 1,
            "unit": "%"
          },
          {
            "id": "fire_area_val",
            "expression": "flammable/equivalent_fire_area",
            "format": "progress_with_max",
            "maxAttribute": "tank/tank_top_total_area",
            "precision": 1,
            "unit": "%"
          }
        ]
      }
    }
  ],
  "bundle_ids": [],
  "config": {
    "label": [
      {
        "name": "储罐状态",
        "format": "table",
        "show": {
          "expression": "ever('flammable/is_burning') || 'health/durability' < 99"
        },
        "items": [
          {
            "label": "温度",
            "expression": "container/temperature",
            "unit": "°C"
          },
          {
            "label": "火面积",
            "expression": "'flammable/equivalent_fire_area' / 'tank/tank_top_total_area' * 100",
            "unit": "%"
          }
        ]
      }
    ]
  },
