  {
    "id": "example-fire-response",
    "name": "示例：火灾响应流程",
    "enabled": false,
    "priority": 0,
    "participants": [],
    "workflow": {
      "edges": [
        {
          "id": "efe_1",
          "kind": "control",
          "source": "efr_1",
          "target": "efr_2"
        },
        {
          "id": "efe_2",
          "kind": "control",
          "source": "efr_1",
          "target": "efr_3"
        },
        {
          "id": "efe_3",
          "kind": "control",
          "source": "efr_1",
          "target": "efr_4"
        },
        {
          "id": "efe_4",
          "kind": "data",
          "source": "efr_2",
          "target": "efr_5"
        },
        {
          "id": "efe_5",
          "kind": "data",
          "source": "efr_3",
          "target": "efr_5"
        },
        {
          "id": "efe_6",
          "kind": "data",
          "source": "efr_4",
          "target": "efr_5"
        },
        {
          "id": "efe_7",
          "kind": "data",
          "source": "efr_5",
          "target": "efr_6"
        },
        {
          "id": "efe_8",
          "kind": "control",
          "source": "efr_6",
          "sourceHandle": "true",
          "target": "efr_7"
        },
        {
          "id": "efe_9",
          "kind": "control",
          "source": "efr_6",
          "sourceHandle": "true",
          "target": "efr_8"
        },
        {
          "id": "efe_10",
          "kind": "control",
          "source": "efr_6",
          "sourceHandle": "false",
          "target": "efr_9"
        },
        {
          "id": "efe_11",
          "kind": "control",
          "source": "efr_7",
          "target": "efr_10"
        },
        {
          "id": "efe_12",
          "kind": "control",
          "source": "efr_8",
          "target": "efr_10"
        }
      ],
      "nodes": [
        {
          "config": {
            "participantId": "scene"
          },
          "enabled": true,
          "id": "efr_1",
          "kind": "participant_source",
          "name": "火灾现场",
          "order": 1
        },
        {
          "config": {
            "reads": [
              {
                "name": "fire_intensity",
                "componentKey": "fire",
                "fieldKey": "intensity"
              }
            ],
            "assignments": []
          },
          "enabled": true,
          "id": "efr_2",
          "kind": "calculate",
          "name": "读取火势等级",
          "order": 2
        },
        {
          "config": {
            "reads": [
              {
                "name": "fire_area",
                "componentKey": "fire",
                "fieldKey": "area"
              }
            ],
            "assignments": []
          },
          "enabled": true,
          "id": "efr_3",
          "kind": "calculate",
          "name": "读取火势面积",
          "order": 3
        },
        {
          "config": {
            "reads": [
              {
                "name": "avail_resources",
                "componentKey": "resource_pool",
                "fieldKey": "available"
              }
            ],
            "assignments": []
          },
          "enabled": true,
          "id": "efr_4",
          "kind": "calculate",
          "name": "读取可用资源",
          "order": 4
        },
        {
          "config": {
            "expression": "fire_intensity * fire_area * 0.5",
            "inputVariables": [
              "fire_intensity",
              "fire_area"
            ],
            "outputType": "number",
            "outputVariable": "required_resources"
          },
          "enabled": true,
          "id": "efr_5",
          "kind": "calculate",
          "name": "计算所需资源",
          "order": 5
        },
        {
          "config": {
            "expression": "avail_resources >= required_resources"
          },
          "enabled": true,
          "id": "efr_6",
          "kind": "condition",
          "name": "资源是否充足",
          "order": 6
        },
        {
          "config": {
            "componentKey": "resource_pool",
            "fieldKey": "allocated",
            "participantId": "resources",
            "valueExpression": "required_resources"
          },
          "enabled": true,
          "id": "efr_7",
          "kind": "write_field",
          "name": "调度资源",
          "order": 7
        },
        {
          "config": {
            "componentKey": "fire",
            "fieldKey": "status",
            "participantId": "scene",
            "valueExpression": "\"responding\""
          },
          "enabled": true,
          "id": "efr_8",
          "kind": "write_field",
          "name": "更新火灾状态",
          "order": 8
        },
        {
          "config": {
            "eventKey": "fire_response.insufficient_resources",
            "payloadBindings": {
              "available": "avail_resources",
              "required": "required_resources"
            }
          },
          "enabled": true,
          "id": "efr_9",
          "kind": "emit_event",
          "name": "资源不足",
          "order": 9
        },
        {
          "config": {
            "eventKey": "fire_response.dispatched",
            "payloadBindings": {
              "resources": "required_resources"
            }
          },
          "enabled": true,
          "id": "efr_10",
          "kind": "emit_event",
          "name": "已调度完成",
          "order": 10
        }
      ],
      "type": "workflow"
    }
  },
  {
