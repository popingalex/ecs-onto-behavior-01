[
  {
    "id": "example-resource-dispatch",
    "name": "示例：资源调度流程",
    "enabled": false,
    "priority": 0,
    "participants": [],
    "workflow": {
      "edges": [
        {
          "id": "ede_1",
          "kind": "control",
          "source": "erd_1",
          "target": "erd_2"
        },
        {
          "id": "ede_2",
          "kind": "control",
          "source": "erd_1",
          "target": "erd_3"
        },
        {
          "id": "ede_3",
          "kind": "control",
          "source": "erd_1",
          "target": "erd_4"
        },
        {
          "id": "ede_4",
          "kind": "data",
          "source": "erd_2",
          "target": "erd_5"
        },
        {
          "id": "ede_5",
          "kind": "data",
          "source": "erd_3",
          "target": "erd_5"
        },
        {
          "id": "ede_6",
          "kind": "data",
          "source": "erd_4",
          "target": "erd_5"
        },
        {
          "id": "ede_7",
          "kind": "data",
          "source": "erd_5",
          "target": "erd_6"
        },
        {
          "id": "ede_8",
          "kind": "control",
          "source": "erd_6",
          "sourceHandle": "true",
          "target": "erd_7"
        },
        {
          "id": "ede_9",
          "kind": "control",
          "source": "erd_6",
          "sourceHandle": "false",
          "target": "erd_9"
        },
        {
          "id": "ede_10",
          "kind": "data",
          "source": "erd_7",
          "target": "erd_8"
        },
        {
          "id": "ede_11",
          "kind": "control",
          "source": "erd_8",
          "target": "erd_10"
        }
      ],
      "nodes": [
        {
          "config": {
            "participantId": "pool"
          },
          "enabled": true,
          "id": "erd_1",
          "kind": "participant_source",
          "name": "资源池",
          "order": 1
        },
        {
          "config": {
            "reads": [
              {
                "name": "total_resources",
                "componentKey": "inventory",
                "fieldKey": "total"
              }
            ],
            "assignments": []
          },
          "enabled": true,
          "id": "erd_2",
          "kind": "calculate",
          "name": "读取资源总量",
          "order": 2
        },
        {
          "config": {
            "reads": [
              {
                "name": "used_resources",
                "componentKey": "inventory",
                "fieldKey": "in_use"
              }
            ],
            "assignments": []
          },
          "enabled": true,
          "id": "erd_3",
          "kind": "calculate",
          "name": "读取已占用资源",
          "order": 3
        },
        {
          "config": {
            "reads": [
              {
                "name": "demand_amount",
                "componentKey": "request",
                "fieldKey": "required"
              }
            ],
            "assignments": []
          },
          "enabled": true,
          "id": "erd_4",
          "kind": "calculate",
          "name": "读取调度需求",
          "order": 4
        },
        {
          "config": {
            "expression": "total_resources - used_resources",
            "inputVariables": [
              "total_resources",
              "used_resources"
            ],
            "outputType": "number",
            "outputVariable": "free_resources"
          },
          "enabled": true,
          "id": "erd_5",
          "kind": "calculate",
          "name": "计算可用资源",
          "order": 5
        },
        {
          "config": {
            "expression": "free_resources >= demand_amount"
          },
          "enabled": true,
          "id": "erd_6",
          "kind": "condition",
          "name": "资源是否满足",
          "order": 6
        },
        {
          "config": {
            "expression": "min(demand_amount, free_resources)",
            "inputVariables": [
              "demand_amount",
              "free_resources"
            ],
            "outputType": "number",
            "outputVariable": "allocation"
          },
          "enabled": true,
          "id": "erd_7",
          "kind": "calculate",
          "name": "计算分配量",
          "order": 7
        },
        {
          "config": {
            "componentKey": "inventory",
            "fieldKey": "allocated",
            "participantId": "pool",
            "valueExpression": "allocation"
          },
          "enabled": true,
          "id": "erd_8",
          "kind": "write_field",
          "name": "写入分配结果",
          "order": 8
        },
        {
          "config": {
            "eventKey": "resource_dispatch.rejected",
            "payloadBindings": {
              "demand": "demand_amount",
              "free": "free_resources"
            }
          },
          "enabled": true,
          "id": "erd_9",
          "kind": "emit_event",
          "name": "资源不足",
          "order": 9
        },
        {
          "config": {
            "eventKey": "resource_dispatch.completed",
            "payloadBindings": {
              "allocated": "allocation",
              "total": "total_resources"
            }
          },
          "enabled": true,
          "id": "erd_10",
          "kind": "emit_event",
          "name": "调度完成",
          "order": 10
        }
      ],
      "type": "workflow"
    }
  },
  {
    "id": "example-sprinkler",
    "name": "示例：喷淋决策",
    "enabled": false,
    "priority": 0,
    "participants": [],
    "workflow": {
      "type": "workflow",
      "nodes": [
        {
          "id": "n1",
          "kind": "participant_source",
          "name": "读取喷淋器",
          "config": {
            "participantId": "sprayers"
          }
        },
        {
          "id": "n2",
          "kind": "streaming",
          "name": "过滤：有控制组件",
          "config": {
            "mode": "filter",
            "condition": "has_controlled_component"
          },
          "inputs": [
            {
              "id": "in",
              "type": "stream",
              "label": "entities"
            }
          ],
          "outputs": [
            {
              "id": "true",
              "type": "stream",
              "label": "pass"
            },
            {
              "id": "false",
              "type": "stream",
              "label": "drop"
            }
          ]
        },
        {
          "id": "n3",
          "kind": "streaming",
          "name": "分流：有喷水指令",
          "config": {
            "mode": "split",
            "condition": "has_spray_cmd"
          },
          "inputs": [
            {
              "id": "cond",
              "type": "value",
              "label": "condition"
            }
          ],
          "outputs": [
            {
              "id": "true",
              "type": "stream",
              "label": "spray"
            },
            {
              "id": "false",
              "type": "stream",
              "label": "idle"
            }
          ]
        },
        {
          "id": "n4",
          "kind": "calculate",
          "name": "计算用水量",
          "config": {
            "expression": "consumption = flow_rate * 1.1",
            "mode": "map"
          },
          "inputs": [
            {
              "id": "in",
              "type": "value",
              "label": "commands"
            }
          ],
          "outputs": [
            {
              "id": "stream",
              "type": "stream",
              "label": "passthrough"
            },
            {
              "id": "value",
              "type": "value",
              "label": "consumption"
            }
          ]
        }
      ],
      "edges": [
        {
          "id": "e1",
          "source": "n1",
          "sourcePort": "out",
          "target": "n2",
          "targetPort": "in"
        },
        {
          "id": "e2",
          "source": "n2",
          "sourcePort": "true",
          "target": "n3",
          "targetPort": "cond"
        }
      ]
    }
  },
